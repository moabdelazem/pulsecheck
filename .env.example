# Copy to .env (git-ignored) and change the password: cp .env.example .env
# Used by compose.yml.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=pulsecheck

# Host "postgres" is the database service inside the compose network.
# Keep user, password and database name in sync with the values above.
DATABASE_URL=postgres://postgres:postgres_dev_password@postgres:5432/pulsecheck?sslmode=disable

# Optional
CHECK_INTERVAL=30s
CHECK_TIMEOUT=5s
